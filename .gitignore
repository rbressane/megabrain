.DS_Store
__pycache__/
*.py[cod]
.coverage
.pytest_cache/
.context/
.megabrain/
test-results/
dist/
node_modules/

# Impeccable keeps the selected direction; working reviews and rejected comps stay local.
.impeccable/hook.cache.json
.impeccable/questions/
.impeccable/review/
.impeccable/mocks/decision/*
!.impeccable/mocks/decision/technical-graph-first.json
!.impeccable/mocks/decision/technical-graph-first.png

# MegaBrain knowledge must never be supplied through environment files.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
